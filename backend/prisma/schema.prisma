// admin-dashboard — Prisma schema
//
// Migrations workflow:
//   Local:     pnpm db:migrate --name descriptive_change
//   CI/deploy: pnpm db:deploy
//   Reset DB:  pnpm prisma migrate reset   (dev only — wipes data)
//
// Rules:
//   - Every schema change is a migration file, committed to git and reviewed
//     like any other code.
//   - Never edit a production database by hand. Never run `db push` against prod.
//   - Migration names are descriptive: `add_user_email_index`, not `fix1`.
//   - Destructive migrations (drop/rename a column) get a code review AND a
//     backup snapshot before deploy.
//
// ─── CONVENTIONS (deliberate departures from the old admin-template schema) ──
//
// 1. MONEY IS `Decimal(10,2)`, matching the old schema. NEVER Float — floats
//    cannot represent 0.1 exactly and money arithmetic drifts.
//    Prisma maps Decimal to a Decimal.js instance, NOT a JS number. That has
//    two consequences every route must respect:
//      - `JSON.stringify` turns it into a string, so API responses carry
//        "49.99", not 49.99. Serialise deliberately (`.toFixed(2)`) rather
//        than letting it leak inconsistently.
//      - Never do arithmetic with `+` or `*` on these values. Use Decimal.js
//        methods (`.plus()`, `.times()`), or the result silently becomes a
//        string concatenation.
//    See docs/PROJECT_STATUS.md for the money-handling helper this needs.
//
// 2. camelCase in Prisma, snake_case in MySQL. `@map` / `@@map` bridge the two,
//    so TypeScript reads naturally while the database keeps SQL conventions.
//
// 3. Every model has `createdAt`. Every mutable model also has `updatedAt`.
//    The old schema was inconsistent (`placed_at` on orders, nothing at all on
//    order_items), which makes "what changed recently" queries impossible.
//
// 4. Enums are Prisma enums, not free VARCHARs — invalid states become
//    compile errors rather than runtime surprises.
//
// 5. Explicit `onDelete` on every relation. Deletion behaviour is a design
//    decision; leaving it implicit means finding out during an incident.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ═══════════════════════════════════════════════════════════════════
// ENUMS
// ═══════════════════════════════════════════════════════════════════

/// Staff roles, highest privilege first. Enforced by the API; the UI only
/// mirrors it.
///
/// `custom` from the old system is deliberately not carried over — per-user
/// permission JSON meant every check had to special-case it. Re-add only if a
/// real need appears.
///
/// DEMO is read-only across every area, enforced at a middleware choke point
/// rather than per-route (see middleware/authorize.ts). It exists so a
/// prospective client can be shown the real dashboard with real data and no
/// possibility of them changing anything.
enum StaffRole {
  DEVELOPER
  OWNER
  MANAGER
  FULFILLMENT
  SUPPORT
  DEMO
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  SHIPPED
  DELIVERED
  CANCELED
  RETURNED
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

/// Simplified from a 5-value original (which also had RECEIVED and REFUNDED):
/// only approve and reject are reachable through any route, so those two
/// states would have been dead — never set, never checked. Approving a
/// return IS the terminal, resolution-recording action here (see
/// Return.resolution), not the first step of a longer pipeline.
enum ReturnStatus {
  REQUESTED
  APPROVED
  REJECTED
}

/// What happens for the customer once a return is approved. NONE is not a
/// real outcome — it exists so a freshly REQUESTED return has a value at all,
/// the same reason Order.paymentMethod is optional rather than required.
enum ReturnResolution {
  NONE
  REFUND
  STORE_CREDIT
  REPLACEMENT
}

/// A fixed bucket for "why is this being returned", alongside — not instead
/// of — `Return.reason`'s free text. A dropdown alone would lose "arrived
/// with a cracked lid" down to whichever bucket is closest; free text alone
/// (the previous shape) cannot be grouped for a reason-analytics report
/// (TODO_SPEC.md's stated ask). OTHER is the deliberate escape hatch — this
/// list is not, and does not try to be, exhaustive.
enum ReturnCategory {
  DAMAGED
  WRONG_ITEM
  NOT_AS_DESCRIBED
  NO_LONGER_NEEDED
  ARRIVED_LATE
  OTHER
}

enum DiscountType {
  PERCENT
  FIXED
}

enum DeliveryStaffStatus {
  ACTIVE
  ON_SHIFT
  INACTIVE
}

enum DeliveryStatus {
  ASSIGNED
  PICKED_UP
  OUT_FOR_DELIVERY
  DELIVERED
  HANDED_OVER
  /// Terminal states, added with group D.
  ///
  /// Group B could not reflect a cancelled or returned ORDER on its assignment,
  /// because this enum had no value to write — so a courier kept a live job for
  /// an order that no longer existed. That gap was documented in
  /// orders.config.ts rather than papered over; these close it.
  CANCELED
  RETURNED
  /// A courier attempted delivery and could not complete it (customer not
  /// home, refused, wrong address, ...). Deliberately NOT terminal: the same
  /// job is retried from here — see `COURIER_TRANSITIONS` in
  /// couriers.service.ts. `DeliveryAssignment.attemptCount` and
  /// `.failureReason` carry the detail this status alone can't.
  FAILED_ATTEMPT
}

// ═══════════════════════════════════════════════════════════════════
// BUSINESSES & BRANCHES
// ═══════════════════════════════════════════════════════════════════

/// One business the owner runs — a cafe, a restaurant, a food truck.
///
/// ─── ONE INSTALL, MANY BUSINESSES ────────────────────────────────────
/// This deployment belongs to ONE owner, who may run several businesses in
/// it, each with its own branches. That is deliberately NOT multi-tenancy:
/// there is a single owner and a single login, so this is an organising
/// level, not a security boundary between strangers.
///
/// It still has to isolate properly. A cafe and a restaurant under one owner
/// have different menus, different staff and different revenue, and mixing
/// them would make every report silently wrong rather than visibly broken.
///
/// ─── WHY TWO LEVELS AND NOT ONE ──────────────────────────────────────
/// A `Location` model alone (the older Track D §S7.5 idea) would make two
/// BUSINESSES look like two shelves of one shop — their products, customers
/// and reports would merge. A branch shares its business's catalogue and
/// staff; a second business shares nothing. Those are different
/// relationships and need different levels.
model Business {
  id   String @id @default(cuid())
  name String @db.VarChar(160)

  /// Free text, since a business type is a label for the owner's benefit
  /// rather than something the app branches on — a "cafe" and a "food truck"
  /// run identically here. Kept so a future template/wizard has something to
  /// key off without needing a migration first.
  kind String? @db.VarChar(60)

  /// "Every detail of the shop" (F8.5). All optional: an owner setting up
  /// their first business should not have to fill in a tax id before they
  /// can add a product.
  legalName   String? @map("legal_name") @db.VarChar(200)
  taxId       String? @map("tax_id") @db.VarChar(60)
  email       String? @db.VarChar(255)
  phone       String? @db.VarChar(40)
  addressLine String? @map("address_line") @db.VarChar(255)
  city        String? @db.VarChar(120)
  country     String? @db.VarChar(2)
  /// ISO 4217 (AED, USD). NULL falls back to the store-wide currency setting
  /// rather than defaulting to one — guessing a currency is how money gets
  /// displayed wrong with no error.
  currency    String? @db.VarChar(3)
  /// IANA zone (Asia/Dubai). Matters because opening hours and a shift that
  /// crosses midnight are meaningless without one.
  timezone    String? @db.VarChar(64)
  logoUrl     String? @map("logo_url") @db.VarChar(512)

  /// Deactivated rather than deleted: a closed business still owns the orders
  /// and audit history that explain last year's numbers.
  isActive Boolean @default(true) @map("is_active")

  branches Branch[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([isActive])
  @@map("businesses")
}

/// One physical place a business operates from — a shop, a warehouse, a
/// truck. Stock, orders and shifts live HERE, not on the business.
///
/// Branches of the same business share its catalogue and its people; what
/// differs is what is physically present and who is working. That is why
/// stock becomes per-branch (F8.2) while products stay per-business.
///
/// Also absorbs the "previous warehouses" the owner asked about: a warehouse
/// is a branch that happens not to sell — `isSellingPoint` says which,
/// instead of a separate model that would duplicate every stock relation.
model Branch {
  id         String   @id @default(cuid())
  businessId String   @map("business_id")
  /// Cascade: a branch cannot outlive the business it belongs to. Businesses
  /// are deactivated rather than deleted (see `isActive`), so in practice
  /// this only fires for a business removed before it was ever used.
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  name String  @db.VarChar(160)
  /// Short human code for labels and paperwork ("MAR", "WH1"). Unique per
  /// business, not globally — two businesses may both have a "MAIN".
  code String? @db.VarChar(24)

  addressLine String? @map("address_line") @db.VarChar(255)
  city        String? @db.VarChar(120)
  phone       String? @db.VarChar(40)
  /// Overrides the business timezone for a branch in another zone. NULL means
  /// "use the business's", never UTC.
  timezone    String? @db.VarChar(64)

  /// False for a warehouse or prep kitchen — it holds stock but takes no
  /// orders. Reports that count "shops" can filter on it rather than
  /// hard-coding a name convention.
  isSellingPoint Boolean @default(true) @map("is_selling_point")
  isActive       Boolean @default(true) @map("is_active")

  /// The branch a movement is attributed to when no branch is named.
  ///
  /// Explicit, NOT inferred from "oldest branch". Ordering by `createdAt`
  /// looked equivalent and was not: this table's first row is written by a
  /// migration using MySQL's `NOW(3)`, which records the SERVER's local time,
  /// while every later row comes from Prisma in real UTC. On a machine four
  /// hours ahead of UTC the seeded branch sorts AFTER branches created later,
  /// so "oldest" silently returned the wrong one and stock landed at the
  /// wrong place with nothing erroring.
  ///
  /// A flag cannot drift with a timezone. Exactly one branch should carry it;
  /// the service falls back to any active branch if none does, rather than
  /// refusing to record stock.
  isDefault Boolean @default(false) @map("is_default")

  stock BranchStock[]
  /// Who works here, and in what capacity (F8.4).
  staff UserBranch[]
  /// Which couriers serve this branch (O2).
  couriers DeliveryStaffBranch[]
  /// Work periods recorded here (F6.1).
  shifts   Shift[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([businessId, code])
  @@index([businessId, isActive])
  @@map("branches")
}

// ═══════════════════════════════════════════════════════════════════
// STAFF & PLATFORM
// ═══════════════════════════════════════════════════════════════════

/// A dashboard user. Distinct from `Customer` — customers never log in here.
model User {
  id              String    @id @default(cuid())
  email           String    @unique @db.VarChar(255)
  name            String?   @db.VarChar(255)
  phone           String?   @db.VarChar(48)
  /// bcrypt hash. NEVER selected into an API response — see the `safeUser`
  /// helper once auth lands.
  passwordHash    String    @map("password_hash") @db.VarChar(255)
  role            StaffRole @default(MANAGER)
  isActive        Boolean   @default(true) @map("is_active")
  /// Optional time-boxed access, e.g. a contractor. NULL = never expires.
  accessExpiresAt DateTime? @map("access_expires_at")
  lastLoginAt     DateTime? @map("last_login_at")

  /// Bumped to invalidate every token this user holds.
  ///
  /// Without it, a stolen JWT stays valid until it expires — currently seven
  /// days — and there is nothing anyone can do about it. A password reset or a
  /// deactivation that leaves the old session working is not a revocation.
  ///
  /// The token carries this number; authenticate compares it to the row. One
  /// increment invalidates every device at once, which is exactly what someone
  /// asks for when they say a laptop was stolen.
  tokenVersion Int @default(0) @map("token_version")

  /// ─── Brute-force protection ──────────────────────────────────────
  /// Per-ACCOUNT, deliberately separate from the per-IP rate limiter.
  /// IP limiting alone does not stop a slow distributed attack against one
  /// known admin email; account lockout alone lets one IP spray many accounts.
  /// Both are needed, and they fail in different directions.
  /// Reset to 0 on every successful login.
  failedLoginAttempts Int       @default(0) @map("failed_login_attempts")
  /// Set when the attempt threshold is crossed. Logins are refused until this
  /// passes, regardless of whether the password is correct.
  lockedUntil         DateTime? @map("locked_until")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  /// ─── Two-factor authentication (TOTP) ─────────────────────────────
  /// AES-256-GCM ciphertext of the TOTP secret, keyed by `TWO_FACTOR_SECRET`
  /// — MUST be reversible (unlike every other secret in this schema), since
  /// verifying a live 6-digit code means recomputing it from the same secret
  /// the authenticator app was given. See two-factor.service.ts.
  twoFactorSecret  String? @map("two_factor_secret") @db.VarChar(255)
  /// True only once the OWNER has confirmed a real code during setup — a
  /// secret can exist (mid-setup) without 2FA actually being required yet.
  /// Login only demands a code when THIS is true, never merely when a
  /// secret is present.
  twoFactorEnabled Boolean @default(false) @map("two_factor_enabled")

  passwordResetTokens  PasswordResetToken[]
  sessions             Session[]
  twoFactorBackupCodes TwoFactorBackupCode[]
  apiKeys              ApiKey[]
  branchRoles          UserBranch[]
  /// Periods of work (F6.1). Three relations because a shift names up to
  /// three different people: whose it is, who opened it, who corrected it.
  shifts               Shift[]               @relation("ShiftWorker")
  shiftsOpened         Shift[]               @relation("ShiftOpener")
  shiftsEdited         Shift[]               @relation("ShiftEditor")

  @@index([role])
  @@index([createdAt])
  @@map("users")
}

/// What role a person holds AT ONE BRANCH (F8.4).
///
/// ─── WHY A JOIN AND NOT A COLUMN ─────────────────────────────────────
/// The owner's question was "what if we have different ppl in different
/// branches". The natural extension is that the SAME person is a barista at
/// Marina and a manager at Downtown — one person, two roles, decided by where
/// they are working. A second column on `User` cannot express that; only a row
/// per (person, branch) can.
///
/// ─── `User.role` IS KEPT, AND STILL MEANS SOMETHING ──────────────────
/// It is the BUSINESS-WIDE role, and it remains the only role for anyone who
/// has no row here. That is deliberate on three counts:
///
///   1. OWNER and DEVELOPER are not branch-scoped concepts. An owner does not
///      stop being the owner by looking at another branch, and scoping them
///      would mean an owner could lock themselves out of their own business by
///      deleting a row.
///   2. Every existing user keeps working unchanged. This migration grants
///      nothing and revokes nothing — a person with no `UserBranch` row is
///      exactly as privileged as they were before it existed.
///   3. It is the floor, never the ceiling. The resolver takes the branch role
///      when one exists and the global role otherwise; it never ADDS the two
///      together, because a union of grants would let a Marina-only manager
///      reach Downtown's data by holding any global role at all.
///
/// ─── WHY THE ROLE IS NOT NULLABLE ────────────────────────────────────
/// A row here means "this person works at this branch, in this capacity". A
/// row with no role would have to mean either "works here with their global
/// role" (which is what having NO row already means) or "works here with no
/// permissions" (which is what `isActive: false` on the user already means).
/// Both readings already have a representation, so a null would be a third
/// spelling of an existing state — and the kind that gets read the wrong way.
model UserBranch {
  id String @id @default(cuid())

  userId String @map("user_id")
  /// Cascade: a role assignment has no meaning without the person. Removing a
  /// user removes where they worked; the AUDIT of what they did survives, in
  /// `AuditLog`, which references actors by plain id for exactly this reason.
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  branchId String @map("branch_id")
  /// Cascade for the same reason: closing a branch removes its roster, not the
  /// history of what happened there.
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  /// The role this person holds AT THIS BRANCH. Same enum as `User.role` —
  /// deliberately not a separate one, because "manager" has to mean the same
  /// set of areas wherever it is granted, or `ROLE_AREAS` stops being the
  /// single source of truth it says it is.
  role StaffRole

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  /// One role per person per branch. The pair is the identity: two rows would
  /// make "what can they do here" ambiguous, and the resolver would have to
  /// pick one — silently, and differently depending on row order.
  @@unique([userId, branchId])
  @@index([branchId])
  @@map("user_branches")
}

/// One row per issued token — what "Sessions & devices" reads, and what a
/// per-session revoke sets `revokedAt` on.
///
/// ─── WHY THIS DIDN'T EXIST BEFORE `tokenVersion` ─────────────────────
/// `tokenVersion` answers "is ANY token this user holds still valid" with one
/// integer, checked without a second query on every request — cheap, and
/// enough for "this laptop was stolen, kill everything." It cannot answer "is
/// THIS ONE token, from the login three days ago on this phone, still
/// valid" — that needs a row per login to point at.
///
/// ─── WHY BOTH MECHANISMS STAY, RATHER THAN ONE REPLACING THE OTHER ───
/// A full sign-out-everywhere (password change, deactivation) is still one
/// `tokenVersion` bump — correct, and cheaper than updating every session row
/// individually, especially for an account with a long login history. Revoking
/// ONE session is a single `Session.revokedAt` write. `authenticate` checks
/// both: a token is only good if its version still matches the user's live
/// counter AND (when the token carries a session id) that session hasn't been
/// individually revoked.
model Session {
  id     String @id @default(cuid())
  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Free text from the User-Agent header, truncated at write time. Attacker-
  /// controlled and only ever DISPLAYED, never parsed for a security decision.
  userAgent String? @map("user_agent") @db.VarChar(255)
  /// Same honesty rule as the audit log's `ip` column: null when there is no
  /// trustworthy answer (see `trust proxy` in app.ts), never a guess.
  ip        String? @db.VarChar(64)

  createdAt  DateTime  @default(now()) @map("created_at")
  /// Updated opportunistically (see session.service.ts) — NOT on every single
  /// request, which would turn "list my sessions" into a write-heavy endpoint
  /// for something whose precision to the second nobody needs.
  lastSeenAt DateTime  @default(now()) @map("last_seen_at")
  /// Null while live. Set once, on purpose or via the bulk sign-out-everywhere
  /// path — never cleared, so a revoked session cannot be reactivated by
  /// unsetting a flag.
  revokedAt  DateTime? @map("revoked_at")

  @@index([userId, revokedAt])
  @@map("sessions")
}

/// One-time recovery codes for 2FA — the escape hatch for "I lost my phone."
/// Ten are generated at enrolment, shown to the user exactly once, and each
/// is consumed the first time it is used. HMAC-hashed like a courier access
/// code or password-reset token, never the HMAC of a PASSWORD — this table
/// only ever needs comparison, never recovery, so a one-way hash is correct
/// here (unlike `User.twoFactorSecret`, which must be reversible).
model TwoFactorBackupCode {
  id     String @id @default(cuid())
  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  codeHash String @unique @map("code_hash")

  createdAt DateTime  @default(now()) @map("created_at")
  /// Null while unused. Consumed codes are kept, not deleted — deleting one
  /// would silently drop the count below ten with no record of why, and
  /// "how many of my ten codes are left" is a real question the account
  /// panel answers by counting rows where this is null.
  usedAt    DateTime? @map("used_at")

  @@index([userId])
  @@map("two_factor_backup_codes")
}

/// An API key for external integrations — B3.2's "Integrations & API" section.
///
/// ─── WHY IT HAS NO SCOPE LIST OF ITS OWN ──────────────────────────────
/// The obvious design gives each key its own permission set, independent of
/// who created it. This app already has exactly one permission model —
/// `Area`, checked by `canAccessArea(role, area)` — and a second, parallel one
/// for keys would mean every route gains a SECOND authorization path to keep
/// in sync with the first, which is how a permission check quietly drifts out
/// of one of the two. Instead a key inherits its OWNER's role-based grants
/// exactly, the same way a browser session does. `revokedAt` still lets that
/// key be cut off independently of the owner's own session.
///
/// ─── WHY THE HASH, NOT THE KEY, IS STORED ─────────────────────────────
/// Same reasoning as a courier access code or password-reset token: this
/// table only ever needs comparison, never recovery, so a one-way HMAC is
/// correct and the plaintext is shown to the creator exactly once.
model ApiKey {
  id     String @id @default(cuid())
  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Human label ("CI pipeline", "Inventory sync script") — the only way to
  /// tell keys apart once the plaintext is gone forever.
  name String @db.VarChar(120)

  /// Keyed HMAC-SHA256, indexed for a one-read lookup on every authenticated
  /// request that uses a key instead of a session token.
  keyHash    String @unique @map("key_hash")
  /// First and last 4 characters of the plaintext, e.g. "adk_a1b2…9x8y" —
  /// shown in the list so an admin can recognise which key is which without
  /// the plaintext ever being stored or re-derivable from this alone.
  keyPreview String @map("key_preview") @db.VarChar(32)

  lastUsedAt DateTime? @map("last_used_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  /// Null while live. Revoking creates no gap in the audit trail the way a
  /// delete would — the row (and who created it) stays visible in history.
  revokedAt  DateTime? @map("revoked_at")

  @@index([userId, revokedAt])
  @@map("api_keys")
}

/// An admin-issued, single-use credential that lets a locked-out staff member
/// set their OWN new password without the admin ever learning it.
///
/// Separate table rather than a column on User, like DeliveryStaff.accessCode:
/// this one is time-boxed and single-use, so it needs its own expiry and
/// redemption timestamp rather than a single slot that only ever holds one
/// live value.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Keyed HMAC-SHA256, never the plaintext — same reasoning as courier access
  /// codes. The plaintext is returned to the issuing admin exactly once.
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  /// NULL until redeemed. A used or expired token is rejected identically to
  /// an unknown one — telling them apart is an enumeration oracle.
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@map("password_reset_tokens")
}

/// Key/value application settings. JSON value so a setting can hold a scalar
/// or an object without a migration per setting.
model Setting {
  key       String   @id @db.VarChar(64)
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("settings")
}

/// In-app notification for dashboard staff.
model Notification {
  id     String  @id @default(cuid())
  type   String  @db.VarChar(48)
  title  String  @db.VarChar(255)
  body   String? @db.Text
  /// Optional in-app deep link, e.g. "/admin/orders/ORD-1024".
  link   String? @db.VarChar(255)
  isRead Boolean @default(false) @map("is_read")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([isRead, createdAt])
  @@map("notifications")
}

// ═══════════════════════════════════════════════════════════════════
// CATALOGUE
// ═══════════════════════════════════════════════════════════════════

model Category {
  id       String  @id @default(cuid())
  name     String  @db.VarChar(160)
  slug     String  @unique @db.VarChar(160)
  isActive Boolean @default(true) @map("is_active")

  products  Product[]
  discounts Discount[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("categories")
}

model Product {
  id          String        @id @default(cuid())
  name        String        @db.VarChar(200)
  sku         String?       @unique @db.VarChar(64)
  description String?       @db.Text
  price       Decimal       @default(0) @db.Decimal(10, 2)
  /// What this unit costs the business to acquire — NULL means "not tracked
  /// yet", never 0. Margin/contribution-margin reporting must skip a product
  /// with no cost recorded rather than silently treat it as free.
  cost        Decimal?      @db.Decimal(10, 2)
  imageUrl    String?       @map("image_url") @db.VarChar(512)
  status      ProductStatus @default(ACTIVE)
  stock       Int           @default(0)

  /// Per-product low-stock threshold, overriding `inventory.lowStockThreshold`
  /// (the store-wide setting) for THIS product.
  ///
  /// NULL means "use the store default" — not zero, and not "never warn". A
  /// business selling both espresso beans and espresso machines cannot have
  /// one sensible number for both, which is what the single global setting
  /// forced.
  lowStockThreshold Int? @map("low_stock_threshold")

  /// Where this product is normally kept, as FREE TEXT for now (F7.8).
  ///
  /// Deliberately a string and not a relation: there is no `Location` model
  /// yet, and inventing one as a side effect of adding a label would commit
  /// the schema to a design nobody has scoped (multi-branch stock, per-branch
  /// counts, transfers between them — see MASTER_TODO F7.9). A string answers
  /// "which shelf/room is this on" today and migrates cleanly to a relation
  /// later, because a real Location will need a name anyway.
  ///
  /// This is the DEFAULT for the product. A specific batch can say otherwise
  /// on its own movement — same relationship as `cost` (the product's usual
  /// cost) versus `StockMovement.unitCost` (what one delivery actually cost).
  storageLocation String? @map("storage_location") @db.VarChar(120)

  /// EAN/UPC/GTIN — distinct from `sku` (that's this business's own catalogue
  /// code; a barcode is the globally-scannable one printed on the unit).
  barcode         String?  @unique @db.VarChar(64)
  /// Kilograms. NULL means "not recorded", never 0 — same "unknown, not
  /// free/weightless" discipline as `cost`, since a fabricated 0 would break
  /// any future shipping-rate calculation silently.
  weightKg        Decimal? @map("weight_kg") @db.Decimal(10, 3)
  lengthCm        Decimal? @map("length_cm") @db.Decimal(10, 2)
  widthCm         Decimal? @map("width_cm") @db.Decimal(10, 2)
  heightCm        Decimal? @map("height_cm") @db.Decimal(10, 2)
  /// Harmonized System code for customs declarations. Free text, not
  /// validated against the real HS nomenclature — this app has no tariff
  /// database to validate against.
  hsCode          String?  @map("hs_code") @db.VarChar(20)
  /// ISO 3166-1 alpha-2 (e.g. "AE", "CN"). Not enforced as an enum — the
  /// admin config layer, not the schema, is this app's validation surface
  /// for catalogue fields (see admin.config.ts's own header comment).
  countryOfOrigin String?  @map("country_of_origin") @db.VarChar(2)

  /// URL-safe identifier. NULL means "not set yet" — nothing in this app
  /// resolves a product BY slug today (no public storefront exists), so
  /// this is a recorded value for a future public site, not a live route
  /// key. Optional and never auto-derived from `name` on write: silently
  /// re-deriving it on every rename is exactly what `redirects` exists to
  /// avoid needing.
  slug            String? @unique @db.VarChar(220)
  /// Falls back to `name` wherever meta title is rendered — NULL is "use
  /// the default", not "no title".
  metaTitle       String? @map("meta_title") @db.VarChar(160)
  metaDescription String? @map("meta_description") @db.VarChar(320)

  categoryId String?   @map("category_id")
  /// SetNull, not Cascade — deleting a category must never delete products.
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  orderItems    OrderItem[]
  reviews       Review[]
  variants      ProductVariant[]
  images        ProductImage[]
  discounts     Discount[]
  redirects     ProductRedirect[]
  cartItems     CartItem[]
  wishlistItems WishlistItem[]

  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")
  stockMovements StockMovement[]
  branchStock    BranchStock[]

  @@index([status])
  @@index([categoryId])
  @@index([createdAt])
  @@map("products")
}

/// One row per slug a product used to have. Written automatically whenever
/// a product's `slug` changes away from a non-null previous value — never
/// on the FIRST slug being set (there is no "old" slug to redirect from
/// yet). Purely a recorded history today: no route in this app resolves a
/// product by slug, so nothing consumes this table live (see the header
/// comment on `Product.slug`). Exists so a future public site has the
/// mapping ready rather than needing it reconstructed from the audit log.
model ProductRedirect {
  id        String   @id @default(cuid())
  oldSlug   String   @unique @map("old_slug") @db.VarChar(220)
  productId String   @map("product_id")
  /// Cascade: a redirect for a deleted product is dead weight, not history
  /// worth keeping — unlike the product's OWN records (orders, audit log),
  /// nothing points at a ProductRedirect that would orphan.
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([productId])
  @@map("product_redirects")
}

/// A flat variant row — "Red / Large" as one line with its own price, stock
/// and SKU, not an attribute matrix (Size × Color generating combinations).
/// Deliberately the simpler of the two designs: covers most real catalogues
/// without the combinatorial-matrix complexity a full attribute system needs.
///
/// Inventory-only in this pass: no relation to OrderItem. This codebase has
/// no real checkout/order-creation flow to wire a variant selection into (see
/// the Discount model's own note on the same gap) — a variant's stock is
/// real and append-only, but nothing here claims a variant can be purchased.
model ProductVariant {
  id    String  @id @default(cuid())
  name  String  @db.VarChar(120)
  sku   String? @unique @db.VarChar(64)
  price Decimal @db.Decimal(10, 2)
  /// Denormalised running total, same pattern as Product.stock — the
  /// movements below are the truth, this column exists so a list doesn't sum
  /// a table per row.
  stock Int     @default(0)

  productId String  @map("product_id")
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  stockMovements StockMovement[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([productId])
  @@map("product_variants")
}

/// Additional catalogue images beyond `Product.imageUrl` (kept as the
/// "primary/cover" image — unchanged, still what every existing list/cell
/// renders). A real model with its own id and `position`, not a JSON array:
/// matches how everything else with real identity in this schema is
/// modelled (StockMovement, OrderItem), and `position` needs a real column
/// to reorder against.
model ProductImage {
  id       String  @id @default(cuid())
  url      String  @db.VarChar(512)
  position Int     @default(0)
  /// Nullable, not defaulted to `""` — an empty string LOOKS filled in to a
  /// form that just checks truthiness, so leaving it genuinely absent keeps
  /// "nobody wrote alt text for this image" a real, queryable state rather
  /// than one indistinguishable from "someone wrote an empty string".
  alt      String? @db.VarChar(255)

  productId String  @map("product_id")
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([productId, position])
  @@map("product_images")
}

// ═══════════════════════════════════════════════════════════════════
// CUSTOMERS & ORDERS
// ═══════════════════════════════════════════════════════════════════

/// A shopper on the public storefront.
///
/// Deliberately NOT the same model as `User`, which is STAFF: `User` carries
/// `StaffRole`, a bcrypt password, 2FA, lockout counters and the whole RBAC
/// surface (`authorize.ts`). A customer must never be able to acquire any of
/// that, and keeping the two tables apart makes that structural rather than a
/// rule someone has to remember. The token side of the same separation lives
/// in `customer-auth.service.ts`.
model Customer {
  id            String  @id @default(cuid())
  name          String  @db.VarChar(200)
  email         String  @unique @db.VarChar(255)
  phone         String? @db.VarChar(48)
  city          String? @db.VarChar(96)
  country       String? @db.VarChar(96)
  /// Staff-only, never surfaced to the customer. Plain free text — no tag
  /// vocabulary, deliberately (see the design note on Order.internalNotes).
  internalNotes String? @map("internal_notes") @db.Text

  /// ─── Storefront sign-in (Google) ──────────────────────────────────
  /// Google's stable subject id (`sub`). NULL for a customer created by staff
  /// or by a guest checkout — those rows are order history, not accounts, and
  /// must keep working. A first Google sign-in on a matching email adopts the
  /// existing row rather than creating a duplicate customer.
  ///
  /// There is deliberately NO password column: the storefront authenticates
  /// only via Google ID tokens, so this app never stores a customer credential
  /// that could leak.
  googleId     String?   @unique @map("google_id") @db.VarChar(64)
  /// Google profile picture URL, shown in the storefront header. Display only.
  picture      String?   @db.VarChar(512)
  lastLoginAt  DateTime? @map("last_login_at")
  /// Bumped to invalidate every storefront token this customer holds — the
  /// same revocation mechanism `User.tokenVersion` gives staff.
  tokenVersion Int       @default(0) @map("token_version")

  orders        Order[]
  reviews       Review[]
  returns       Return[]
  discounts     Discount[]
  cartItems     CartItem[]
  wishlistItems WishlistItem[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([createdAt])
  @@map("customers")
}

model Order {
  id String @id @default(cuid())

  /// Which branch took this order (F8.3).
  ///
  /// Nullable so the migration can backfill rather than demand a default, and
  /// because an order outlives the branch that took it — a closed shop's
  /// orders still explain last year's revenue. Reports treat a null branch as
  /// UNATTRIBUTED and say so, rather than silently folding it into whichever
  /// branch happens to sort first.
  ///
  /// A plain id, not a relation, for the same reason `AuditLog.actorId` is:
  /// history has to survive the thing it points at being removed.
  branchId String? @map("branch_id") @db.VarChar(64)

  /// Human-facing reference shown to customers and couriers, e.g. "ORD-1024".
  orderNumber   String      @unique @map("order_number") @db.VarChar(40)
  /// Denormalised on purpose: the order total must not change if a product's
  /// price is edited after the order was placed. Grand total — what the
  /// customer actually paid, tax included. Every existing reader (Reports,
  /// Dashboard KPIs) already treats this as the order's money figure; that
  /// meaning does NOT change with `subtotal`/`taxAmount` below.
  total         Decimal     @default(0) @db.Decimal(10, 2)
  /// Sum of line items before tax. NULL, not 0, on orders that predate this
  /// column or were never run through a tax-aware creation path — 0 would
  /// falsely claim "confirmed, no tax," which is a different fact from
  /// "never recorded." Set once at creation, same snapshot discipline as
  /// `total` and `OrderItem.price`.
  subtotal      Decimal?    @db.Decimal(10, 2)
  /// `subtotal * store.taxRate` at the time of the order, snapshotted for the
  /// same reason `OrderItem.price` is: a later change to `store.taxRate`
  /// must not rewrite what an old invoice already showed. NULL has the same
  /// "never recorded" meaning as `subtotal`'s.
  taxAmount     Decimal?    @map("tax_amount") @db.Decimal(10, 2)
  status        OrderStatus @default(PENDING)
  paymentMethod String?     @map("payment_method") @db.VarChar(48)
  placedAt      DateTime    @default(now()) @map("placed_at")

  customerId String?   @map("customer_id")
  /// SetNull so deleting a customer preserves order history for accounting.
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  items         OrderItem[]
  /// Staff-only, never surfaced to the customer — a THREAD (C5.7), not the
  /// single overwritable field this used to be. See `OrderNote`'s own doc
  /// comment for why.
  notes         OrderNote[]
  statusHistory OrderStatusHistory[]
  assignment    DeliveryAssignment?
  returns       Return[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([status])
  @@index([customerId])
  @@index([placedAt])
  @@map("orders")
}

model OrderItem {
  id       String   @id @default(cuid())
  quantity Int      @default(1)
  /// Price AT TIME OF ORDER. Never read the live product price when
  /// displaying a historical order.
  price    Decimal  @default(0) @db.Decimal(10, 2)
  /// Unit COST at time of order — the other half of the snapshot above, and
  /// for the same reason. Margin reporting used to join `products.cost` live,
  /// which meant a supplier price change silently rewrote the recorded profit
  /// on every order already in the book.
  ///
  /// Nullable, and NULL means "cost was not recorded at sale time" — a real,
  /// permanent gap, never a 0 (same discipline as `Product.cost`). Rows
  /// written before this column existed stay NULL on purpose: backfilling
  /// them from today's `products.cost` would fabricate exactly the history
  /// this column exists to preserve. Margin reporting EXCLUDES them and
  /// counts them, rather than quietly shrinking its own denominator.
  cost     Decimal? @db.Decimal(10, 2)

  orderId String @map("order_id")
  /// Cascade — an order's items have no meaning without the order.
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId String?  @map("product_id")
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  returnItems ReturnItem[]

  createdAt DateTime @default(now()) @map("created_at")

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

// ═══════════════════════════════════════════════════════════════════
// STOREFRONT (public shopping surface)
// ═══════════════════════════════════════════════════════════════════

/// A signed-in shopper's cart line.
///
/// Carts are storefront-only — nothing in the admin UI reads them. Guests keep
/// their cart in browser storage instead and it is merged here on sign-in, so
/// a row only ever exists for an authenticated customer.
///
/// Deliberately stores NO price: a cart is a live intention, so it must show
/// today's price. Snapshotting happens at checkout, on `OrderItem.price` —
/// the opposite discipline to an order, and for the opposite reason.
model CartItem {
  id       String @id @default(cuid())
  quantity Int    @default(1)

  customerId String   @map("customer_id")
  /// Cascade — a deleted customer's cart is meaningless. Order history is NOT
  /// cascaded (see `Order.customerId`), because that has accounting value.
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  productId String  @map("product_id")
  /// Cascade — a delisted product must leave the cart rather than linger as a
  /// line that cannot be ordered.
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  /// One line per product per customer. The storefront's add-to-cart relies on
  /// this for an atomic upsert-and-increment — without it, two rapid taps
  /// create two rows instead of quantity 2.
  @@unique([customerId, productId], map: "uq_cart_customer_product")
  @@index([customerId])
  @@map("cart_items")
}

/// A product a customer saved for later ("liked").
model WishlistItem {
  id String @id @default(cuid())

  customerId String   @map("customer_id")
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  productId String  @map("product_id")
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([customerId, productId], map: "uq_wishlist_customer_product")
  @@index([customerId])
  @@map("wishlist_items")
}

/// Staff-only order notes — a THREAD, not a single overwritable field (C5.7).
/// The previous shape (`Order.internalNotes`, one blob every save replaced)
/// meant a second staff member's note silently erased the first one's; this
/// is append-only like every other history table in this file, for the same
/// reason `OrderStatusHistory` is: "who said what, and when" must survive
/// being edited again.
model OrderNote {
  id   String @id @default(cuid())
  body String @db.Text

  /// Who wrote it. Plain id, not a relation — same rule as
  /// `OrderStatusHistory.changedById`: the thread must survive the staff
  /// member being deleted, not lose its own history along with the account.
  authorId String? @map("author_id")

  orderId String @map("order_id")
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([orderId, createdAt])
  @@map("order_notes")
}

/// Audit trail of order status changes. Not in the old schema — added because
/// "who moved this order to shipped, and when" is a question the dashboard
/// will be asked, and it cannot be answered retroactively.
model OrderStatusHistory {
  id          String       @id @default(cuid())
  fromStatus  OrderStatus? @map("from_status")
  toStatus    OrderStatus  @map("to_status")
  /// Free-text reason, e.g. "customer requested cancellation".
  note        String?      @db.VarChar(255)
  /// Who made the change. Plain id, not a relation — the history must survive
  /// the staff member being deleted.
  changedById String?      @map("changed_by_id")

  orderId String @map("order_id")
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([orderId, createdAt])
  @@map("order_status_history")
}

/// A return request against a DELIVERED (or SHIPPED) order. Bespoke, not a
/// configured resource — approving one is a procedure (validates the order
/// can legally move to RETURNED, optionally restocks, records a resolution),
/// the same reason orders and delivery are bespoke rather than config.
model Return {
  id              String           @id @default(cuid())
  /// Human-facing reference, e.g. "RMA-7F3K9QZR". Never the row id.
  rmaNumber       String           @unique @map("rma_number")
  reason          String           @db.VarChar(500)
  /// NULL on any return requested before this was tracked — a real "never
  /// classified" gap, not a silent OTHER. Existing rows are left alone
  /// rather than guessed at from their free-text `reason`.
  category        ReturnCategory?
  status          ReturnStatus     @default(REQUESTED)
  resolution      ReturnResolution @default(NONE)
  /// Set only when resolution = REFUND. Capped at approval time to the sum of
  /// the RETURNED line items' recorded price — never the order's live total.
  refundAmount    Decimal?         @map("refund_amount") @db.Decimal(10, 2)
  /// Whether approving created a matching StockMovement per item. Recorded
  /// here so the return's own history says whether stock was ever adjusted,
  /// without re-deriving it from the movement log.
  restocked       Boolean          @default(false)
  /// Staff's own words for why a return was refused. Set only on REJECTED —
  /// same free-text, snapshot-once discipline as `reason` itself. NULL on
  /// anything not (yet) rejected, not an empty string.
  rejectionReason String?          @map("rejection_reason") @db.VarChar(500)

  orderId String @map("order_id")
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  customerId String?   @map("customer_id")
  /// SetNull, same reasoning as Order.customer — a deleted customer must not
  /// take their return history with them.
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  items ReturnItem[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([orderId])
  @@index([customerId])
  @@index([status, createdAt])
  @@map("returns")
}

/// A line item being returned — a QUANTITY against an existing OrderItem, not
/// a copy of it. Price and product are read through the relation so a return
/// can never disagree with what the order actually recorded.
model ReturnItem {
  id       String @id @default(cuid())
  quantity Int

  returnId String @map("return_id")
  /// Cascade — a return's items have no meaning without the return.
  return   Return @relation(fields: [returnId], references: [id], onDelete: Cascade)

  orderItemId String    @map("order_item_id")
  /// Restrict, not cascade or set-null: an order's line items are themselves
  /// cascade-deleted only with their order, and a Return already cascades
  /// from Order via its own orderId — deleting just the ITEM while the return
  /// survives would leave a return line pointing at nothing.
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([returnId])
  @@index([orderItemId])
  @@map("return_items")
}

model Review {
  id     String       @id @default(cuid())
  /// 1-5. Enforced in the API layer with Zod; MySQL has no CHECK on TINYINT.
  rating Int          @default(5) @db.TinyInt
  body   String?      @db.Text
  status ReviewStatus @default(PENDING)

  productId String?  @map("product_id")
  product   Product? @relation(fields: [productId], references: [id], onDelete: Cascade)

  customerId String?   @map("customer_id")
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([status])
  @@index([productId])
  @@map("reviews")
}

/// A discount applies to exactly ONE scope kind, never combined — a
/// discount is ALL/CATEGORY/PRODUCT/CUSTOMER, not a rule engine stacking
/// conditions. Matches the "config is an allowlist, not a rule engine"
/// simplicity already used elsewhere (settings.config.ts, admin.config.ts).
enum DiscountScope {
  ALL
  CATEGORY
  PRODUCT
  CUSTOMER
}

model Discount {
  id        String        @id @default(cuid())
  code      String        @unique @db.VarChar(48)
  type      DiscountType  @default(PERCENT)
  /// For PERCENT: the percentage itself (10.00 = 10%). For FIXED: a money
  /// amount. Same Decimal(10,2) as every other monetary column.
  value     Decimal       @db.Decimal(10, 2)
  maxUses   Int?          @map("max_uses")
  usedCount Int           @default(0) @map("used_count")
  expiresAt DateTime?     @map("expires_at")
  isActive  Boolean       @default(true) @map("is_active")
  /// Which scope kind this discount targets. Only the ONE matching relation
  /// below (categories/products/customers) is meaningful when scope is not
  /// ALL — the admin form shows all three pickers, but the app only ever
  /// reads the one `scope` names.
  scope     DiscountScope @default(ALL)

  /// Plain implicit many-to-many — no extra columns on the join, so Prisma
  /// manages the join table itself rather than a hand-declared model (unlike
  /// ProductImage, which needs a `position` column and so gets a real model).
  categories Category[]
  products   Product[]
  customers  Customer[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([isActive, expiresAt])
  @@map("discounts")
}

// ═══════════════════════════════════════════════════════════════════
// DELIVERY
// ═══════════════════════════════════════════════════════════════════

/// A courier. Separate from `User` — couriers log into the delivery portal
/// with an access code, not into the admin dashboard.
model DeliveryStaff {
  id             String              @id @default(cuid())
  name           String              @db.VarChar(255)
  email          String?             @db.VarChar(255)
  phone          String?             @db.VarChar(48)
  vehicleType    String?             @map("vehicle_type") @db.VarChar(48)
  plateNumber    String?             @map("plate_number") @db.VarChar(48)
  licenseNumber  String?             @map("license_number") @db.VarChar(64)
  zone           String?             @db.VarChar(96)
  region         String?             @db.VarChar(96)
  country        String?             @db.VarChar(96)
  status         DeliveryStaffStatus @default(ACTIVE)
  /// HMAC of the courier's login code — never the code itself.
  ///
  /// An access code is a CREDENTIAL. Storing it in plain text means a database
  /// leak hands over every courier account, and it puts the code into backups,
  /// query logs and anyone's SELECT.
  ///
  /// Plain bcrypt would be the usual answer, but it cannot be looked up: every
  /// hash carries its own salt, so sign-in would have to scan and compare every
  /// courier. A keyed HMAC is deterministic, so a unique index still resolves a
  /// code in one indexed read while the stored value is useless without the
  /// server secret.
  ///
  /// The trade-off, stated plainly: HMAC is fast, so an attacker holding BOTH
  /// the database and the secret could brute-force short codes. Mitigated by
  /// generating long codes from a large alphabet and rate-limiting sign-in.
  accessCodeHash String?             @unique @map("access_code_hash") @db.VarChar(64)

  assignments DeliveryAssignment[]
  /// Which branches this courier serves (O2). Many, not one — see the model.
  branches    DeliveryStaffBranch[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([status])
  @@map("delivery_staff")
}

/// Which branches a courier serves (O2).
///
/// ─── WHY A JOIN TABLE AND NOT `branchId` ON THE COURIER ──────────────
/// The owner's answer, 2026-09-08: a courier can serve one branch and another
/// as well. A single `branchId` cannot express that, and the alternative --
/// a second courier ROW per branch -- was considered and rejected: it splits
/// one person's delivery history across timelines that can never be added up,
/// and hands them a different sign-in code per branch. The credential lives on
/// `DeliveryStaff`, so duplicating the row duplicates the credential.
///
/// One courier record, many branches. Same shape as `UserBranch`, deliberately,
/// so "who works where" is one idea in this schema and not two.
///
/// ─── NO ROLE COLUMN, UNLIKE `UserBranch` ─────────────────────────────
/// A courier's capabilities do not vary by branch -- they deliver. `UserBranch`
/// carries a role because a staff member genuinely can be a manager at one shop
/// and support at another; there is no equivalent axis here, and adding a
/// column "for symmetry" would invite a meaning nobody has defined.
model DeliveryStaffBranch {
  id String @id @default(cuid())

  courierId String        @map("courier_id")
  /// Cascade: serving a branch has no meaning without the courier. Their
  /// ASSIGNMENTS are history and reference the courier separately.
  courier   DeliveryStaff @relation(fields: [courierId], references: [id], onDelete: Cascade)

  branchId String @map("branch_id")
  /// Cascade for the same reason: closing a branch removes its roster, never
  /// the record of deliveries made from it.
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  /// One row per courier per branch. Two would make "does he serve here"
  /// ambiguous for no gain -- there is no per-row attribute to differ on.
  @@unique([courierId, branchId])
  @@index([branchId])
  @@map("delivery_staff_branches")
}

/// Links an order to a courier. The delivery address is denormalised here so a
/// courier's view never needs to read customer records.
model DeliveryAssignment {
  id            String         @id @default(cuid())
  customerName  String?        @map("customer_name") @db.VarChar(255)
  customerPhone String?        @map("customer_phone") @db.VarChar(48)
  address       String?        @db.VarChar(255)
  area          String?        @db.VarChar(96)
  city          String?        @db.VarChar(96)
  country       String?        @db.VarChar(96)
  /// Amount to collect on delivery. Null = prepaid.
  total         Decimal?       @db.Decimal(10, 2)
  paymentMethod String?        @map("payment_method") @db.VarChar(48)
  status        DeliveryStatus @default(ASSIGNED)
  note          String?        @db.VarChar(255)

  /// How many delivery attempts have failed so far. Incremented only by a
  /// courier reporting FAILED_ATTEMPT, never reset by a retry — "third
  /// attempt" must stay knowable after the job cycles back to
  /// OUT_FOR_DELIVERY, the same reason a StockMovement correction doesn't
  /// erase the mistake it corrects.
  attemptCount  Int     @default(0) @map("attempt_count")
  /// Free text from the courier, e.g. "customer not home", "refused at
  /// door". Set on FAILED_ATTEMPT, left as-is on a successful retry — a
  /// staff member reviewing a 3rd attempt wants to see what the 1st and 2nd
  /// said too, not just the latest, but this column only ever holds the
  /// most recent one; the full history lives in AuditLog.
  failureReason String? @map("failure_reason") @db.VarChar(255)

  /// One assignment per order.
  orderId String @unique @map("order_id")
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  driverId String        @map("driver_id")
  /// Cascade matches the old schema: removing a courier removes their
  /// assignments. Reassign before deleting a courier with live deliveries.
  driver   DeliveryStaff @relation(fields: [driverId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([driverId, status])
  @@index([status])
  @@map("delivery_assignments")
}

/// Why stock moved. Required on every movement — an unexplained adjustment is
/// indistinguishable from a mistake when someone audits the count later.
enum StockMovementReason {
  RECEIVED
  SOLD
  DAMAGED
  LOST
  RETURNED
  CORRECTION
}

/// How much of one product is at one branch (F8.2).
///
/// ─── WHY A TABLE AND NOT A COLUMN ────────────────────────────────────
/// `Product.stock` is a single number, so "how much is at Marina" was not
/// merely unbuilt — it was unanswerable. A column cannot hold one value per
/// branch, and a JSON blob would put a number nothing can index or sum
/// behind a shape no query can filter on.
///
/// ─── `Product.stock` IS KEPT, AND STILL MEANS SOMETHING ──────────────
/// It becomes the ALL-BRANCH total: the sum of every row here for that
/// product. It is not abandoned and it is not a duplicate — "how much do we
/// own in total" is a real question (reorder decisions, valuation, the
/// catalogue list) and answering it should not require summing a table per
/// row, which is the same reasoning that made it denormalised in the first
/// place.
///
/// So there are now two denormalised totals, each with its own truth:
///   StockMovement (per branch)  ->  BranchStock.quantity  ->  Product.stock
/// Every write moves all three inside one transaction. `reconcile()` checks
/// the first link; a second check for the second link is worth adding when
/// this ships.
model BranchStock {
  id String @id @default(cuid())

  productId String  @map("product_id")
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  branchId String @map("branch_id")
  /// Cascade: a branch's stock rows have no meaning without the branch. The
  /// MOVEMENTS survive it (they are history, and reference the branch by a
  /// plain id) — this row is only the running total.
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  /// Same denormalised-running-total contract as `Product.stock`: the
  /// movements for this product AND branch are the truth, this is the sum so
  /// a list does not have to compute it per row.
  quantity Int @default(0)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  /// One row per product per branch — the pair is the identity, and the
  /// unique constraint is what makes an upsert on it safe under concurrency.
  @@unique([productId, branchId])
  @@index([branchId])
  @@map("branch_stock")
}

/// Stock as a LOG, not a number you overwrite.
///
/// `product.stock` is a denormalised running total kept in step by the same
/// transaction that writes the movement. The movements are the truth; the
/// column exists so a product list doesn't have to sum a table per row.
///
/// Deliberately append-only: there is no update path. Getting a movement wrong
/// is corrected by a compensating CORRECTION movement, so the trail records
/// what actually happened, including the mistake.
model StockMovement {
  id String @id @default(cuid())

  /// Where this movement happened (F8.2).
  ///
  /// Nullable ONLY so the migration can add it and backfill every existing row
  /// to the seeded branch. Left nullable rather than made required because a
  /// NOT NULL with a hardcoded default would silently attribute a future
  /// orphaned movement to whichever branch that default named.
  ///
  /// A plain id, not a relation, for the same reason `actorId` is: the trail
  /// has to survive the thing it references being removed. The branch's
  /// running total (`BranchStock`) cascades away with the branch; this record
  /// of what actually happened does not.
  branchId String? @map("branch_id") @db.VarChar(64)

  /// Signed. +50 received, -3 damaged. The sum of deltas for a product equals
  /// its stock — a test asserts exactly that.
  delta    Int
  reason   StockMovementReason
  /// What ONE unit in this movement cost to acquire (F1.4a).
  ///
  /// Records what a given delivery actually cost, so cost drift over time is
  /// visible rather than collapsed into the product's single current `cost`.
  ///
  /// NULL means "not recorded", never 0 — same discipline as `Product.cost`
  /// and `OrderItem.cost`. Only meaningful on a movement where stock is
  /// ACQUIRED (RECEIVED, and arguably RETURNED); a DAMAGED/LOST/SOLD movement
  /// has no acquisition cost to record, and the API refuses one there rather
  /// than storing a number nothing can interpret.
  ///
  /// Deliberately NOT consumed by profit reporting. COGS reads
  /// `OrderItem.cost`, the snapshot taken at sale time. Making sales draw
  /// down specific batches (FIFO vs. weighted average) is a much larger
  /// design that this column would feed — see MASTER_TODO F1.4a's own note on
  /// why that was deferred rather than rejected: this app has no checkout
  /// flow yet, so batch consumption would have nothing to run on.
  unitCost Decimal?            @map("unit_cost") @db.Decimal(10, 2)
  /// Free-text detail, e.g. "pallet 4, water damage".
  note     String?             @db.VarChar(255)

  /// Exactly ONE of productId/variantId is set, never both, never neither —
  /// enforced in stock.service.ts (MySQL has no CHECK constraint for it). A
  /// product's own movements and a variant's are two separate sums; mixing
  /// them would break "the sum of deltas equals the stock" for either.
  productId String?  @map("product_id")
  /// Cascade: a product's stock history has no meaning without the product.
  /// Products that appear in an order are archived rather than deleted, so
  /// this only ever fires for a product nothing refers to.
  product   Product? @relation(fields: [productId], references: [id], onDelete: Cascade)

  variantId String?         @map("variant_id")
  /// Cascade, same reasoning as `product` above.
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)

  /// Plain id, not a relation — the trail must survive the staff member being
  /// deleted, exactly like OrderStatusHistory.changedById.
  actorId String? @map("actor_id")

  /// ─── BATCH DETAIL (F7.8) ──────────────────────────────────────────
  /// The owner's case, 2026-09-08: "buy the stock of 50 units then enter one
  /// unit details once". A receipt of 50 is ALREADY one row here, so the
  /// batch's facts belong on that row — beside `unitCost`, which is the same
  /// kind of fact and was added for the same reason.
  ///
  /// NOT on `Product`. A product bought three times from two suppliers at
  /// different prices has three answers to "when did it arrive", and a column
  /// there could hold only the newest — silently overwriting the history the
  /// movement log exists to keep. Loose columns on Product would have to be
  /// undone later.
  ///
  /// All optional and all meaningless outside a RECEIVED movement: nothing
  /// was delivered when stock is written off as damaged. The service leaves
  /// them null rather than inventing a date.

  /// When the goods physically arrived. Distinct from `createdAt`, which is
  /// when somebody got round to recording it — often the next morning, and
  /// for a late-entered batch, days later.
  deliveredAt DateTime? @map("delivered_at")
  /// When it was ordered/paid for. Answers "how long does this supplier take"
  /// without a purchase-order model.
  purchasedAt DateTime? @map("purchased_at")
  /// The supplier's own document number — invoice, delivery note, whatever is
  /// printed on the paper in the box. Free text on purpose: every supplier
  /// formats theirs differently and normalising it would reject valid ones.
  reference   String?   @map("reference") @db.VarChar(64)

  supplierId String?   @map("supplier_id")
  /// SetNull, not Cascade: deleting a supplier must never delete stock
  /// history. The batch still happened and its cost still explains the
  /// margin, whether or not you still buy from them.
  supplier   Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([productId, createdAt])
  @@index([variantId, createdAt])
  @@index([supplierId])
  @@map("stock_movements")
}

/// Append-only record of who changed what.
///
/// ─── WHY THE ENGINE IS THE CHOKE POINT ───────────────────────────────
/// Every generic resource write goes through one service, so one hook there
/// covers products, categories, customers, discounts, reviews and anything
/// added later — without each route remembering to log. Bespoke writes
/// (orders, inventory, staff, settings) call it explicitly, because they are
/// the ones a reviewer will look for.
///
/// Deliberately NOT a relation to User: the trail has to survive the person
/// being deleted. An audit row naming a user id that no longer exists is still
/// evidence; a cascade-deleted audit row is not.
model AuditLog {
  id String @id @default(cuid())

  /// What happened: "product.updated", "staff.role.changed", "order.status.changed".
  action   String  @db.VarChar(64)
  /// Which table, so a reviewer can filter without knowing every action name.
  entity   String  @db.VarChar(48)
  /// Row id. Nullable because a delete's target no longer exists to point at.
  entityId String? @map("entity_id") @db.VarChar(64)

  /// Plain id, not a relation — see above.
  actorId    String? @map("actor_id") @db.VarChar(64)
  actorEmail String? @map("actor_email") @db.VarChar(255)
  actorRole  String? @map("actor_role") @db.VarChar(32)

  /// Changed fields only, never the whole row: a full snapshot of a customer
  /// would copy their personal data into a table with a longer retention than
  /// the record itself. Values are redacted for sensitive fields.
  changes Json?

  /// Whether the attempt succeeded. A trail of successes only answers "what
  /// changed"; a security reviewer also needs "what did someone TRY to do and
  /// get refused", which is the shape an attack has before it works.
  outcome AuditOutcome @default(SUCCESS)

  /// Correlates with the request logs, so an entry can be traced end to end.
  requestId String? @map("request_id") @db.VarChar(64)

  /// Where the request came from. Nullable: behind a proxy that does not set
  /// a forwarding header there is no honest answer, and a fabricated one is
  /// worse than a gap in evidence.
  ip String? @db.VarChar(64)

  /// Truncated at write time — a user-agent is attacker-controlled free text.
  userAgent String? @map("user_agent") @db.VarChar(255)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([entity, entityId])
  @@index([actorId, createdAt])
  @@index([createdAt])
  /// Denied attempts are the security-review query, and they are rare relative
  /// to successes — without this the one filter that matters most scans hardest.
  @@index([outcome, createdAt])
  @@index([requestId])
  @@map("audit_log")
}

/// Deliberately not a boolean: "denied" (refused by a permission rule) and
/// "error" (the operation was allowed and then broke) are different events, and
/// collapsing them loses the distinction a reviewer is looking for.
enum AuditOutcome {
  SUCCESS
  DENIED
  ERROR
}

/// Return/Privacy/Terms/Shipping — the four legal/policy documents a store
/// publishes. A fixed enum, same reasoning as `StaffRole`: these four are the
/// whole set the UI and any public-facing consumer need to know about, not an
/// open-ended admin-defined list.
enum PolicyType {
  RETURN
  PRIVACY
  TERMS
  SHIPPING
}

/// One row per (type, locale) — the CURRENTLY PUBLISHED text, denormalised
/// out of `PolicyVersion` for a fast read with no "which version is live"
/// join. Writing here always goes through `publishPolicyVersion()`, never a
/// direct update — see policies.service.ts.
model Policy {
  id String @id @default(cuid())

  type   PolicyType
  /// Plain string, not the frontend's `Locale` type — this table has no
  /// dependency on the frontend package, and validating against `en`/`ar` is
  /// the service's job (mirrors how `Order.status` etc. are validated at the
  /// service layer against the same enum Prisma also encodes).
  locale String     @db.VarChar(8)

  publishedVersionId String        @unique @map("published_version_id")
  publishedVersion   PolicyVersion @relation("PublishedVersion", fields: [publishedVersionId], references: [id])

  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([type, locale])
  @@map("policy")
}

/// Append-only history — every save creates a NEW row, never edits one in
/// place, same discipline as `StockMovement`/`AuditLog`. `Policy.publishedVersionId`
/// points at whichever row is currently live; every other version for that
/// (type, locale) stays queryable for "what did this say on March 3rd" and
/// for reverting without re-typing lost text.
model PolicyVersion {
  id String @id @default(cuid())

  type   PolicyType
  locale String     @db.VarChar(8)

  /// Monotonic per (type, locale), assigned by the service — not an
  /// autoincrement column, so it can be computed inside the same transaction
  /// that also decides whether this version becomes published.
  version Int

  /// Legal prose. Free-form text (Markdown rendered client-side), not HTML —
  /// storing raw HTML from an admin textarea would be a stored-XSS vector the
  /// moment it's rendered on a public-facing page.
  content String @db.Text

  /// Plain id, not a relation — same reasoning as `OrderStatusHistory.changedById`:
  /// the history must survive the author's staff account being deactivated.
  createdById String? @map("created_by_id")

  createdAt DateTime @default(now()) @map("created_at")

  /// The reverse side of `Policy.publishedVersionId` — at most one `Policy`
  /// row can point here, but most versions are OLD and have none.
  publishedAs Policy? @relation("PublishedVersion")

  @@unique([type, locale, version])
  @@index([type, locale, createdAt])
  @@map("policy_version")
}

/// A recurring send of one report to a recipient list (C3.2). Not a saved
/// FILTER — the report key + a fixed range length (last 7/30/90 days,
/// computed relative to send time) is what's saved; there is no "saved
/// custom from/to" concept, since a fixed date range would go stale the
/// moment it was reused a week later.
enum ScheduleFrequency {
  DAILY
  WEEKLY
  MONTHLY
}

/// CSV always works; XLSX/PDF depend on C3.4's export libraries being wired
/// in — `reports.service.ts`'s scheduler send path is the single place that
/// decision matters, not this row.
enum ScheduleFormat {
  CSV
  XLSX
  PDF
}

model ScheduledReport {
  id String @id @default(cuid())

  /// Matches a `ReportView` key on the frontend (`overview`, `revenue`,
  /// `staff-activity`, ...) — plain string, not a Prisma enum, so a new
  /// report type never needs a migration to become schedulable.
  reportKey  String            @map("report_key") @db.VarChar(64)
  frequency  ScheduleFrequency
  format     ScheduleFormat    @default(CSV)
  /// Plain email strings, not a relation to Customer/User — a recipient here
  /// is very often someone with NO account in this system at all (an
  /// external accountant, a franchise owner), same reasoning
  /// `DeliveryAssignment.customerName`/`customerPhone` snapshot rather than
  /// requiring a Customer row to exist.
  recipients Json
  isActive   Boolean           @default(true) @map("is_active")

  /// Set by the scheduler after each attempt — lets the UI show "last sent"
  /// honestly instead of implying every active schedule has actually fired.
  lastRunAt     DateTime? @map("last_run_at")
  lastRunStatus String?   @map("last_run_status") @db.VarChar(16)

  /// Plain id, not a relation — same "the record must survive the staff
  /// member being deleted" rule as every other actor reference in this file.
  createdById String? @map("created_by_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([isActive, frequency])
  @@map("scheduled_reports")
}

/// A period of WORK — who, where, from when to when (F6.1).
///
/// ─── A SHIFT IS NOT A SESSION ────────────────────────────────────────
/// The owner drew this line himself, 2026-09-08: a `Session` is the backlog of
/// activity inside the system, written BY the app when somebody signs in. A
/// shift is declared by the PERSON and describes their working day. They
/// answer different questions and neither can stand in for the other — a
/// cashier can be signed in all night without being on shift, and can be on
/// shift while signed in on somebody else's till.
///
/// ─── ACTUAL TIME ONLY, NO ROTA ───────────────────────────────────────
/// Also his call. There is no planned start to compare against, so no
/// lateness, no no-shows, no schedule editor. A rota is a genuinely different
/// feature and adding two columns "in case" would imply one exists.
///
/// ─── CORRECTIONS STAY VISIBLE ────────────────────────────────────────
/// A manager may fix a shift for somebody who forgot to clock in or out. The
/// original values are KEPT (`originalStartedAt`/`originalEndedAt`) and the
/// edit is attributed (`editedById`), the same discipline `StockMovement` uses
/// for a stock correction: a timesheet that can be silently rewritten is worth
/// less as a record than one that cannot, and this is a record of hours people
/// may be paid for.
///
/// Deliberately NOT payroll (F6.6). No rates, no overtime rules, no
/// jurisdiction-specific rounding. Those carry real legal obligations and are
/// their own project.
model Shift {
  id String @id @default(cuid())

  /// WHOSE shift this is.
  userId String @map("user_id")
  /// Cascade: a shift has no meaning without the person who worked it. The
  /// AUDIT of what they did survives in `AuditLog`, which references actors
  /// by plain id for exactly this reason.
  user   User   @relation("ShiftWorker", fields: [userId], references: [id], onDelete: Cascade)

  /// WHERE it was worked. Required — "who was on at Marina yesterday" is the
  /// question this table exists to answer, and a null branch cannot answer it.
  branchId String @map("branch_id")
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  /// Who OPENED it, distinct from whose shift it is: a manager may open one
  /// for somebody who forgot to clock in. Equal to `userId` in the ordinary
  /// case, which is the overwhelming majority.
  openedById String @map("opened_by_id")
  openedBy   User   @relation("ShiftOpener", fields: [openedById], references: [id])

  startedAt DateTime  @map("started_at")
  /// NULL means STILL OPEN — the single source of truth for "who is on now".
  /// Not a separate status column: two representations of one fact drift, and
  /// an `isOpen` flag disagreeing with a set `endedAt` has no correct reading.
  endedAt   DateTime? @map("ended_at")

  /// What the times were BEFORE a manager corrected them. Null means never
  /// corrected — the ordinary case. Kept rather than overwritten so an edited
  /// timesheet still shows what was originally recorded.
  originalStartedAt DateTime? @map("original_started_at")
  originalEndedAt   DateTime? @map("original_ended_at")
  /// Who made the correction, and why. Null unless edited.
  editedById        String?   @map("edited_by_id")
  editedBy          User?     @relation("ShiftEditor", fields: [editedById], references: [id])
  editReason        String?   @map("edit_reason") @db.VarChar(255)
  editedAt          DateTime? @map("edited_at")

  /// The worker's own note — "covered for Sara", "closed early, power cut".
  note String? @db.VarChar(255)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  /// "Who is on now" and "who was on at this branch" are the two reads this
  /// table exists for; both are covered here.
  @@index([userId, startedAt])
  @@index([branchId, startedAt])
  @@index([endedAt])
  @@map("shifts")
}

/// Who a batch of stock was bought from (F7.9).
///
/// ─── WHY A MODEL AND NOT A STRING ON THE MOVEMENT ────────────────────
/// A supplier is asked the same three questions repeatedly — who do we reorder
/// from, what did they charge last time, what is their email — and free text
/// answers none of them: "Acme Ltd", "acme", and "ACME Ltd." are three
/// suppliers to a query and one to a person. F7.6 (a reorder email sent on
/// approval) needs a real address to send to, which a typo'd string cannot
/// guarantee.
///
/// ─── DELIBERATELY THIN ───────────────────────────────────────────────
/// No payment terms, no lead times, no purchase orders. Those belong to a
/// procurement feature nobody has asked for, and columns added "while we are
/// here" become columns that must be explained later. This holds exactly what
/// receiving stock and emailing a reorder need.
model Supplier {
  id   String  @id @default(cuid())
  name String  @db.VarChar(160)
  /// Where a reorder request is sent (F7.6). Optional: an owner may record a
  /// supplier they only ever phone, and forcing a fake address to save the
  /// row is how bad data gets in.
  email String? @db.VarChar(255)
  phone String? @db.VarChar(40)
  /// Free text — a name, an extension, whatever the owner actually uses.
  contactName String? @map("contact_name") @db.VarChar(160)
  note        String? @db.VarChar(255)

  /// Deactivated rather than deleted: a supplier you no longer buy from still
  /// explains where last year's stock came from. Same rule as Business.
  isActive Boolean @default(true) @map("is_active")

  movements StockMovement[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([isActive])
  @@map("suppliers")
}
