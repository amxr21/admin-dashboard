# ─── admin-dashboard backend — environment template ────────────────
# Copy to .env and fill in real values from the secrets manager.
# NEVER commit .env.
#
# Every variable here is validated at boot by src/config/env.ts. If one is
# missing or malformed, the process exits immediately with a clear message —
# it does not start half-configured and fail later under load.

# ─── Runtime ───────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
LOG_LEVEL=debug        # debug | info | warn | error

# ─── Database (MySQL via Prisma) ───────────────────────────────────
DATABASE_URL=mysql://user:password@localhost:3306/admin_dashboard_dev

# ─── Sentry ────────────────────────────────────────────────────────
# Leave blank in local dev — Sentry is disabled outside production anyway.
SENTRY_DSN=https://your-server-dsn@sentry.io/project-id

# ─── CORS ──────────────────────────────────────────────────────────
# Comma-separated list of allowed origins. No wildcards in production.
CORS_ORIGINS=http://localhost:3000

# ─── Seeding ───────────────────────────────────────────────────────
# `pnpm db:seed` does two things: creates the admin below, then seeds the
# tagged demo dataset (180 days of history, deterministic, removable with
# `pnpm demo:teardown`).
#
# There is deliberately NO default password in the seed script — a known
# default that works in production is how dashboards get breached.
# Minimum 12 characters.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-min-12-chars
# Display name for that account. Optional, defaults to "Admin".
SEED_ADMIN_NAME=Admin

# Set to 0 for a real client deployment that should start with an empty
# catalogue. Anything else (or unset) seeds the demo data. Re-running the seed
# when demo rows already exist skips them rather than failing.
SEED_DEMO_DATA=1

# ─── Public demo instance ──────────────────────────────────────────
# The demo seeder refuses to touch a NODE_ENV=production database, because a
# production catalogue full of `__demo__` rows looks like a data-entry mistake
# rather than a script. A public demo deployment is the one legitimate
# exception: set this to 1 to allow it. Leave it UNSET on any real deployment.
# It does not relax the separate `defaultdb` guard.
# DEMO_DEPLOYMENT=1

# ─── Auth ──────────────────────────────────────────────────────────
# REQUIRED. Minimum 32 characters — the app refuses to boot below that.
# There is no default: a secret shipped in the repo signs tokens anyone who
# has read the code can forge.
#   openssl rand -base64 32
JWT_SECRET=generate-with-openssl-rand-base64-32

# Token lifetime. Short by design — with no revocation list yet, expiry is the
# ONLY thing that invalidates a stolen token. Shorten this, don't lengthen it.
JWT_EXPIRES_IN=7d

# ─── Brute-force protection ────────────────────────────────────────
# Failed attempts before an account locks, and for how long (minutes).
# Per-ACCOUNT, separate from the per-IP limiter in middleware/rateLimit.ts —
# both are needed, they fail in different directions.
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# HMAC key for courier access codes (min 32 chars).
# Generate with: openssl rand -base64 32
# Rotating this invalidates EVERY existing courier access code.
DELIVERY_CODE_SECRET=

# HMAC key for admin-issued password reset tokens (min 32 chars).
# Generate with: openssl rand -base64 32
# Rotating this invalidates EVERY outstanding reset token, nothing else.
PASSWORD_RESET_SECRET=

# AES-256-GCM key that encrypts each user's TOTP secret at rest (exactly 32
# bytes / 64 hex chars — MUST be hex, not base64, so the byte length is
# unambiguous). Unlike every other *_SECRET above, this MUST be reversible:
# verifying a live 6-digit code means recomputing it from the same secret the
# app issued. Rotating this locks every enrolled account out of 2FA until
# they re-enrol — treat it like JWT_SECRET, not like PASSWORD_RESET_SECRET.
# Generate with: openssl rand -hex 32
TWO_FACTOR_SECRET=

# HMAC key for API keys (min 32 chars).
# Generate with: openssl rand -base64 32
# Rotating this invalidates EVERY issued API key.
API_KEY_SECRET=

# Optional dashboard links surfaced by GET /diagnostics (DEVELOPER only).
# URLs only — never credentials.
SENTRY_DASHBOARD_URL=
LOGS_DASHBOARD_URL=

# ─── Image uploads (Cloudinary) ────────────────────────────────────
# Optional — leave all three blank to keep image fields as a plain URL text
# input instead of an upload control. All three or none: a partial set is
# treated as "not configured" (see upload.service.ts).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── Outgoing email (SMTP) ──────────────────────────────────────────
# Optional — leave all four blank to keep alerts in-app only. Also requires
# the "Send email for alerts" toggle and a from-address in Settings
# (Settings itself never holds these credentials — see email.service.ts).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# ─── Support / developer contact ───────────────────────────────────
# Optional. Who the in-app "Contact developer" form (Settings → Support)
# sends to. Unset hides that section entirely for this deployment — set this
# per client during Tier 1 setup, same category as SEED_ADMIN_EMAIL. Requires
# the SMTP block above to also be configured, same as any other outgoing mail.
DEVELOPER_CONTACT_EMAIL=
