# ─── admin-dashboard backend — environment template ────────────────
# Copy to .env and fill in real values from the secrets manager.
# NEVER commit .env.
#
# Every variable here is validated at boot by src/config/env.ts. If one is
# missing or malformed, the process exits immediately with a clear message —
# it does not start half-configured and fail later under load.

# ─── Runtime ───────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
LOG_LEVEL=debug        # debug | info | warn | error

# ─── Database (MySQL via Prisma) ───────────────────────────────────
DATABASE_URL=mysql://user:password@localhost:3306/admin_dashboard_dev

# ─── Sentry ────────────────────────────────────────────────────────
# Leave blank in local dev — Sentry is disabled outside production anyway.
SENTRY_DSN=https://your-server-dsn@sentry.io/project-id

# ─── CORS ──────────────────────────────────────────────────────────
# Comma-separated list of allowed origins. No wildcards in production.
CORS_ORIGINS=http://localhost:3000

# ─── Seeding (dev only) ────────────────────────────────────────────
# Used by `pnpm db:seed` to create the initial admin. There is deliberately NO
# default password in the seed script — a known default that works in
# production is how dashboards get breached. Minimum 12 characters.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-min-12-chars

# ─── Auth ──────────────────────────────────────────────────────────
# REQUIRED. Minimum 32 characters — the app refuses to boot below that.
# There is no default: a secret shipped in the repo signs tokens anyone who
# has read the code can forge.
#   openssl rand -base64 32
JWT_SECRET=generate-with-openssl-rand-base64-32

# Token lifetime. Short by design — with no revocation list yet, expiry is the
# ONLY thing that invalidates a stolen token. Shorten this, don't lengthen it.
JWT_EXPIRES_IN=7d

# ─── Brute-force protection ────────────────────────────────────────
# Failed attempts before an account locks, and for how long (minutes).
# Per-ACCOUNT, separate from the per-IP limiter in middleware/rateLimit.ts —
# both are needed, they fail in different directions.
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# HMAC key for courier access codes (min 32 chars).
# Generate with: openssl rand -base64 32
# Rotating this invalidates EVERY existing courier access code.
DELIVERY_CODE_SECRET=

# HMAC key for admin-issued password reset tokens (min 32 chars).
# Generate with: openssl rand -base64 32
# Rotating this invalidates EVERY outstanding reset token, nothing else.
PASSWORD_RESET_SECRET=

# Optional dashboard links surfaced by GET /diagnostics (DEVELOPER only).
# URLs only — never credentials.
SENTRY_DASHBOARD_URL=
LOGS_DASHBOARD_URL=
