# ─── admin-dashboard frontend — environment template ───────────────
# Copy to .env.local and fill in real values from the secrets manager.
# NEVER commit .env.local.
#
# NEXT_PUBLIC_* variables are inlined into the browser bundle at build time.
# Anything here is public. Never put a secret behind a NEXT_PUBLIC_ prefix.

# API base URL for the Express backend.
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# Environment name (development / preview / production).
# Used by Sentry to tag events and by feature flags.
NEXT_PUBLIC_ENV=development

# ─── Sentry ────────────────────────────────────────────────────────
# Client DSN (public — safe to expose to the browser).
NEXT_PUBLIC_SENTRY_DSN=https://your-client-dsn@sentry.io/project-id

# Server DSN (server-side only — do NOT prefix with NEXT_PUBLIC).
SENTRY_DSN=https://your-server-dsn@sentry.io/project-id

# Source-map upload at build time. Build-only, never exposed to the browser.
# Get one at: Sentry → Settings → Auth Tokens (scope: project:releases).
SENTRY_AUTH_TOKEN=
SENTRY_ORG=your-org-slug
SENTRY_PROJECT=admin-dashboard-frontend

# ─── Auth (uncomment when auth lands) ──────────────────────────────
# NEXTAUTH_URL=http://localhost:3000
# NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32
