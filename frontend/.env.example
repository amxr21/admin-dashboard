# ─── admin-dashboard frontend — environment template ───────────────
# Copy to .env.local and fill in real values from the secrets manager.
# NEVER commit .env.local.
#
# NEXT_PUBLIC_* variables are inlined into the browser bundle at build time.
# Anything here is public. Never put a secret behind a NEXT_PUBLIC_ prefix.

# ─── API backend ───────────────────────────────────────────────────
# Which backend this build talks to. One of: local | dev | prod
#
#   local → NEXT_PUBLIC_API_URL_LOCAL  (must be a localhost/127.0.0.1 URL)
#   dev   → NEXT_PUBLIC_API_URL_DEV    (must NOT be localhost)
#   prod  → NEXT_PUBLIC_API_URL_PROD   (must NOT be localhost)
#
# Unset defaults to `dev`. There is deliberately NO fallback to localhost:
# NEXT_PUBLIC_* is inlined at build time, so a deployed build that lost its
# API URL used to ship `localhost:4000` and make every visitor call their own
# machine. That now fails the build instead. See src/lib/api-config.ts.
#
# Each URL must include the /api/v1 prefix — src/lib/api.ts appends the route
# path directly onto it.
NEXT_PUBLIC_APP_MODE=local

NEXT_PUBLIC_API_URL_LOCAL=http://localhost:4000/api/v1
NEXT_PUBLIC_API_URL_DEV=https://your-dev-backend.onrender.com/api/v1
NEXT_PUBLIC_API_URL_PROD=https://your-prod-backend.example.com/api/v1

# Environment name (development / preview / production).
# Used by Sentry to tag events and by feature flags.
NEXT_PUBLIC_ENV=development

# ─── Sentry ────────────────────────────────────────────────────────
# Client DSN (public — safe to expose to the browser).
NEXT_PUBLIC_SENTRY_DSN=https://your-client-dsn@sentry.io/project-id

# Server DSN (server-side only — do NOT prefix with NEXT_PUBLIC).
SENTRY_DSN=https://your-server-dsn@sentry.io/project-id

# Source-map upload at build time. Build-only, never exposed to the browser.
# Get one at: Sentry → Settings → Auth Tokens (scope: project:releases).
SENTRY_AUTH_TOKEN=
SENTRY_ORG=your-org-slug
SENTRY_PROJECT=admin-dashboard-frontend

# ─── Auth (uncomment when auth lands) ──────────────────────────────
# NEXTAUTH_URL=http://localhost:3000
# NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32
