{
  "name": "@admin-dashboard/frontend",
  "version": "0.1.0",
  "private": true,
  "description": "Admin dashboard frontend — Next.js (App Router).",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "node scripts/assert-no-dev-server.mjs && next build",
    "start": "next start -p 3000",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
