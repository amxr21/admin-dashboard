{
  "name": "admin-dashboard",
  "version": "0.1.0",
  "private": true,
  "description": "Admin dashboard — Next.js frontend + Express/MySQL backend.",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.5.0",
  "scripts": {
    "dev": "pnpm --parallel --filter \"./frontend\" --filter \"./backend\" dev",
    "build": "pnpm --filter \"./backend\" build && pnpm --filter \"./frontend\" build",
    "lint": "pnpm --recursive lint",
    "typecheck": "pnpm --recursive typecheck",
    "db:migrate": "pnpm --filter \"./backend\" db:migrate",
    "db:studio": "pnpm --filter \"./backend\" db:studio"
  }
}
